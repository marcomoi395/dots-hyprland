#!/usr/bin/env bash
set -Eeuo pipefail

SOURCE_DIR=/var/lib/bluetooth

# Windows Registry value names to export, without colons.
KEY_IDS=(
    4142CC9A4544
    41BB00E50A06
)

usage() {
    cat <<'EOF'
Usage: sudo ./bluetooth-key-export

Print a Windows Registry (.reg) file containing selected Bluetooth pairing keys
stored by BlueZ under /var/lib/bluetooth.

Edit KEY_IDS near the top of this script to choose which device IDs to export.
IDs are compared case-insensitively and must not contain colons.

The script does not modify Bluetooth files or any system configuration. Key bytes
are copied exactly as stored by BlueZ; no byte-order conversion is performed.
EOF
}

if (($# > 0)); then
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    *)
        printf 'Unknown option: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
    esac
fi

if [[ $EUID -ne 0 ]]; then
    printf '%s\n' 'This script needs root access to read /var/lib/bluetooth.' >&2
    printf '%s\n' 'Run it as: sudo ./bluetooth-key-export' >&2
    exit 1
fi

if [[ ! -d $SOURCE_DIR ]]; then
    printf 'Bluetooth data directory not found: %s\n' "$SOURCE_DIR" >&2
    exit 1
fi

is_mac_address() {
    [[ $1 =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]
}

is_selected_id() {
    local candidate=${1^^}
    local selected_id

    for selected_id in "${KEY_IDS[@]}"; do
        [[ ${selected_id^^} == "$candidate" ]] && return 0
    done

    return 1
}

read_link_key() {
    awk '
        /^\[LinkKey\]$/ {
            in_section = 1
            next
        }
        in_section && /^\[/ {
            exit
        }
        in_section && /^Key=/ {
            sub(/^Key=/, "")
            print
            found = 1
            exit
        }
        END {
            if (!found) exit 1
        }
    ' "$1"
}

format_reg_hex() {
    local raw=${1^^}
    local formatted=
    local index

    [[ $raw =~ ^([[:xdigit:]]{2})+$ ]] || return 1

    for ((index = 0; index < ${#raw}; index += 2)); do
        [[ -n $formatted ]] && formatted+=,
        formatted+=${raw:index:2}
    done

    printf '%s' "$formatted"
}

adapter_count=0
device_count=0
reg_header_printed=false

for adapter_dir in "$SOURCE_DIR"/*; do
    [[ -d $adapter_dir ]] || continue
    adapter_mac=${adapter_dir##*/}
    is_mac_address "$adapter_mac" || continue

    reg_values=()
    for info_file in "$adapter_dir"/*/info; do
        [[ -f $info_file ]] || continue
        device_dir=${info_file%/info}
        device_mac=${device_dir##*/}
        is_mac_address "$device_mac" || continue

        device_id=${device_mac//:/}
        device_id=${device_id^^}
        is_selected_id "$device_id" || continue

        key_value=$(read_link_key "$info_file" || true)
        [[ -n $key_value ]] || continue
        reg_hex=$(format_reg_hex "$key_value" || true)
        [[ -n $reg_hex ]] || continue

        reg_values+=("\"$device_id\"=hex:$reg_hex")
        device_count=$((device_count + 1))
    done

    ((${#reg_values[@]} > 0)) || continue
    adapter_count=$((adapter_count + 1))

    if [[ $reg_header_printed == false ]]; then
        printf '%s\n\n' 'Windows Registry Editor Version 5.00'
        reg_header_printed=true
    fi

    adapter_id=${adapter_mac//:/}
    adapter_id=${adapter_id,,}
    printf '[HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\BTHPORT\\Parameters\\Keys\\%s]\n' "$adapter_id"
    printf '%s\n' "${reg_values[@]}"
    printf '\n'
done

if ((device_count == 0)); then
    printf '%s\n' 'No selected Bluetooth pairing keys were found.' >&2
    exit 1
fi

printf '; Found %d adapter(s), %d selected device key(s).\n' "$adapter_count" "$device_count"
